import cv2
img = cv2.imread(r"C:\Users\NIVEDHA\OneDrive\Pictures\Desktop\CV\flower.jpg.png", 0)
_, binary = cv2.threshold(img, 127, 255, cv2.THRESH_BINARY)
result = cv2.dilate(binary, None, iterations=1)
cv2.imshow("Dilation", result)
cv2.imwrite("dilation.jpg", result)
cv2.waitKey(0)
cv2.destroyAllWindows()
