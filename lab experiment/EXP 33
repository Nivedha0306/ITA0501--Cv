import cv2
import numpy as np

w = int(input("Enter width: "))
h = int(input("Enter height: "))

img = np.ones((h, w, 3), dtype=np.uint8) * 255
r = min(w, h) // 4

cv2.circle(img, (w//2, h//2), r, (255, 0, 0), 3)

cv2.imshow("Circle", img)
cv2.imwrite("circle.png", img)
cv2.waitKey(0)
cv2.destroyAllWindows()

