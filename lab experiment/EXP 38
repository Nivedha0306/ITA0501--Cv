import cv2
v=cv2.VideoCapture(r"C:\Users\NIVEDHA\OneDrive\Pictures\Desktop\CV\video.mp4.mp4")
face=cv2.CascadeClassifier(cv2.data.haarcascades+"haarcascade_frontalface_default.xml")
while True:
    r,f=v.read()
    if not r: break
    faces=face.detectMultiScale(cv2.cvtColor(f,cv2.COLOR_BGR2GRAY),1.1,5)
    print("Number of Faces:",len(faces))
    cv2.imshow("Face Detection",f)
    if cv2.waitKey(100)&0xFF==ord('q'): break
v.release()
cv2.destroyAllWindows()
